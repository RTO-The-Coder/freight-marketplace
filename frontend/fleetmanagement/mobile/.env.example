# Base URL of the Freight API, read once at app start (configureApi in src/app/_layout.tsx).
# Copy to .env (gitignored) and pick the line for how you run the app:
#
# Android emulator (10.0.2.2 is the emulator's address for this PC):
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5017
#
# Physical phone on the same Wi-Fi: use this PC's network IP, and start the API with
#   dotnet run --project backend/src/Freight.Api --urls http://0.0.0.0:5017
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.118:5017
